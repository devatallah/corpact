APP_NAME=Teamat
APP_ENV=local
APP_KEY=
# Never enable debug in production — it exposes stack traces and credentials to visitors.
# Set to true only in your local .env.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Production must use s3 (league/flysystem-aws-s3-v3 is installed; fill the AWS_* vars below).
# The bucket must be fully private — files are served only via temporary
# signed URLs (FILESYSTEM_SIGNED_URL_MINUTES, default 15).
FILESYSTEM_DISK=local
# FILESYSTEM_SIGNED_URL_MINUTES=15

# database is the local fallback driver. Production must use redis, with
# Horizon running under Supervisor (see docs/deployment.md).
QUEUE_CONNECTION=database
# Horizon dashboard access (comma-separated admin emails), non-local envs only.
HORIZON_ALLOWED_EMAILS=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log is for local development only — no email is actually delivered.
# Production must use a real transport, e.g.:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.your-provider.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls
#   MAIL_USERNAME=...
#   MAIL_PASSWORD=...
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@teamat.sa"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (spatie/laravel-backup): daily at 01:00, 30-day retention.
# Production must ship backups off-server: BACKUP_DISK=s3 (use a separate
# bucket from user uploads). Failure/health alerts go to the mail below.
BACKUP_DISK=local
BACKUP_NOTIFICATION_MAIL=ops@teamat.sa
# Optional password for backup archives (aes256 when set).
BACKUP_ARCHIVE_PASSWORD=

# A11 — الفوترة والتسويات (H §12.7–§12.10).
# ⚠️ إصدار الفواتير الحقيقية موقوف حتى مراجعة محاسب قانوني للصفة الضريبية
# (H §12.9): ما دام false تُصدر الفواتير بوضع «مبدئي» تُحسب وتُخزَّن ولا
# تُقدَّم مستنداً ضريبياً نهائياً. أرقام العقود (رسم الموظف المفعّل، الحد
# الأدنى الشهري، نسبة عمولة المزوّد) ليست إعدادات بيئة — مصدرها العقد.
BILLING_REAL_INVOICES_ENABLED=false
BILLING_SERIAL_PREFIX=TMT-INV
BILLING_SELLER_NAME=تيمات
BILLING_SELLER_VAT_NUMBER=

VITE_APP_NAME="${APP_NAME}"

# ── Notifications / messaging (A14 — H §14, §4) ─────────────────────────────
# Delivery chain, in order. Dev default is the log driver so nothing silently
# no-ops and no real credentials are needed. Production: whatsapp,sms
MESSAGE_CHAIN=log
MESSAGE_LOCALE=ar
MESSAGE_QUIET_HOURS=true

# OTP delivery. Login must never depend on a single channel: with
# OTP_CHANNEL=whatsapp and OTP_FALLBACK_CHANNEL=sms, an unconfigured or failing
# WhatsApp falls through to SMS after 60 seconds.
OTP_CHANNEL=log
OTP_FALLBACK_CHANNEL=

# WhatsApp Business Cloud API — OWNER-SUPPLIED.
# Account + template approval take days to weeks and login depends on them
# (H §4 critical path). Leave disabled until the real values exist; the driver
# reports "not configured" and the chain falls through to SMS.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=ar
# Approved template names. Per-notification names live on
# notification_templates.whatsapp_template_name (admin screen).
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_INVITATION=
WHATSAPP_TEMPLATE_DEFAULT=

# SMS gateway — OWNER-SUPPLIED, vendor-neutral HTTP.
# Must be operable STANDALONE before any pilot (H §4).
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_METHOD=POST
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_SENDER_NAME=
# Field names the gateway expects, if they differ from the defaults.
SMS_FIELD_TO=to
SMS_FIELD_BODY=body
SMS_FIELD_SENDER=sender
