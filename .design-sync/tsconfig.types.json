{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": ".cache/types",
        "rootDir": "../resources/js",
        "skipLibCheck": true
    },
    "include": [
        "../resources/js/components/**/*.tsx",
        "../resources/js/lib/**/*.ts",
        "../resources/js/hooks/**/*.tsx",
        "../resources/js/types/**/*.ts",
        "../resources/js/types/**/*.d.ts"
    ]
}
